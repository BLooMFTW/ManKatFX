# ====================================================================
# ManKatFx Environment Configuration Template (.env.example)
# DO NOT commit real secrets or production keys here.
# Copy this file to .env.local to configure your live credentials.
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Realtime Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Master Administrative PIN Recovery Password
VITE_MASTER_ADMIN_PASSWORD="YourMasterAdminPassword"
